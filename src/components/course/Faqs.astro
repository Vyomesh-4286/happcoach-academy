---
import type { Faq } from '../../data/courses';
interface Props { intro: string; items: Faq[]; contactHref: string }
const { intro, items, contactHref } = Astro.props;
---
<section class="hc-faqs hc-anchor" id="faqs">
  <div class="hc-container">
    <h2 class="hc-h2">FAQs</h2>
    <p class="hc-sub">{intro}</p>

    <div class="hc-faq-list">
      {items.map((f, i) => (
        <details class="hc-faq" name="hc-faq" open={i === 0}>
          <summary>
            <span>{f.question}</span>
            <span class="hc-faq__icon" aria-hidden="true"></span>
          </summary>
          <p class="hc-faq__answer">{f.answer}</p>
        </details>
      ))}
    </div>

    <div class="hc-faqs__more">
      <h3>Still have questions?</h3>
      <a class="hc-btn" href={contactHref}>Contact Us</a>
    </div>
  </div>
</section>
