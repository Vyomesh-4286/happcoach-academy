---
// Inline SVG icons used across the course page. Stroke icons inherit currentColor.
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;

const fileLabel: Record<string, string> = { zip: 'ZIP', ppt: 'PPT', docx: 'DOC', pdf: 'PDF' };
const label = fileLabel[name];
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'star' && (
    <path fill="currentColor" stroke="none" d="M12 2.6l2.9 6 6.5.8-4.8 4.5 1.2 6.5L12 17.2l-5.8 3.2 1.2-6.5L2.6 9.4l6.5-.8z" />
  )}
  {name === 'user' && (<><circle cx="12" cy="8" r="4" /><path d="M4.5 21c.8-4 3.8-6 7.5-6s6.7 2 7.5 6" /></>)}
  {name === 'clock' && (<><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>)}
  {name === 'check-circle' && (
    <><circle cx="12" cy="12" r="10" fill="currentColor" stroke="none" /><path d="M7.5 12.3l3 3 6-6.3" stroke="#1b1b1b" stroke-width="2" /></>
  )}
  {name === 'chevron-down' && <path d="M6 9l6 6 6-6" />}
  {name === 'chevron-right' && <path d="M9 6l6 6-6 6" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'quote' && (
    <path fill="currentColor" stroke="none" d="M3 5h7v7l-3 7H3.6l2.6-7H3zM13 5h7v7l-3 7h-3.4l2.6-7H13z" />
  )}
  {name === 'video-screen' && (<><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M10 8.3v5.4l4.4-2.7zM8 21h8M12 17v4" /></>)}
  {name === 'video' && (<><rect x="2.5" y="5" width="19" height="14" rx="4" /><path d="M10 9v6l5-3z" /></>)}
  {name === 'audio' && (<><path d="M14 3H6.5A1.5 1.5 0 005 4.5v15A1.5 1.5 0 006.5 21h11a1.5 1.5 0 001.5-1.5V8z" /><path d="M14 3v5h5M8.5 14.5h1.5l2.5-2v6l-2.5-2H8.5zM15 13.5a2.5 2.5 0 010 3.5" /></>)}
  {name === 'quiz' && (<><rect x="5" y="4" width="14" height="17" rx="2" /><path d="M9 4V2.8h6V4M9 10h6M9 14h6M9 18h3" /></>)}
  {name === 'doc' && (<><path d="M14 3H6.5A1.5 1.5 0 005 4.5v15A1.5 1.5 0 006.5 21h11a1.5 1.5 0 001.5-1.5V8z" /><path d="M14 3v5h5" /></>)}
  {name === 'link' && (<><path d="M10 14a4.5 4.5 0 006.4 0l3-3a4.5 4.5 0 00-6.4-6.4l-1 1" /><path d="M14 10a4.5 4.5 0 00-6.4 0l-3 3a4.5 4.5 0 006.4 6.4l1-1" /></>)}
  {name === 'image' && (<><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 16l5-5 4 4 3-3 6 6" /></>)}
  {label && (
    <>
      <path d="M14 2.5H7A1.5 1.5 0 005.5 4v9.5M14 2.5v5h5M14 2.5l5 5v6" />
      <text x="12" y="21.5" text-anchor="middle" font-size="7" font-weight="800" font-family="Arial, sans-serif" fill="currentColor" stroke="none">{label}</text>
    </>
  )}
</svg>
