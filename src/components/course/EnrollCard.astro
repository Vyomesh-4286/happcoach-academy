---
import Icon from './Icon.astro';
import { withBase } from '../../lib/url';
import { EDMINGLE } from '../../config/edmingle';
import type { Course } from '../../data/courses';
interface Props { course: Course }
const { course } = Astro.props;

// Courses from Edmingle get MHB-style checkout buttons; the SDK
// (EdmingleSdk.astro) finds them by class name and opens checkout.
const id = course.edmingleBundleId;
const useSdk = Boolean(id && EDMINGLE.subdomain);
---
<aside class="hc-enroll" id="enroll" aria-label="Enroll in this course">
  <img class="hc-enroll__img" src={withBase(course.image)} alt={course.imageAlt} width="446" height="272" />
  <div class="hc-enroll__body">
    <p class="hc-enroll__eyebrow">{course.cardEyebrow}</p>
    <p class="hc-price">
      <strong>{course.price}</strong>
      {course.priceStrike && <s class="hc-price__strike">{course.priceStrike}</s>}
      <small>{course.priceNote}</small>
    </p>
    {useSdk ? (
      <>
        <button type="button" class={`hc-btn hc-btn--lg course-landing-buy_${id}`} data-instbundleid={id}>
          {course.enrollLabel}
        </button>
        {course.freePreview && (
          <button type="button" class={`hc-btn hc-btn--lg hc-btn--ghost open-signup-course-freepreview enrollFree enrollFree_${id}`}>
            Enrol for free
          </button>
        )}
      </>
    ) : (
      <a class="hc-btn hc-btn--lg" href={course.enrollHref}>{course.enrollLabel}</a>
    )}
    <p class="hc-enroll__guarantee">{course.guarantee}</p>
    <hr class="hc-enroll__divider" />
    <h2 class="hc-enroll__includes-title">Your course includes</h2>
    <ul class="hc-enroll__list">
      {course.includes.map((item) => (
        <li><Icon name="check-circle" size={22} />{item}</li>
      ))}
    </ul>
  </div>
</aside>
