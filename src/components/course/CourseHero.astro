---
import Icon from './Icon.astro';
import type { Course } from '../../data/courses';
interface Props { course: Course }
const { course } = Astro.props;
---
<header class="hc-hero">
  <div class="hc-hero__eyebrow">
    <span>{course.eyebrow}</span>
    <span class="hc-pill">{course.category}</span>
  </div>
  <h1 class="hc-hero__title">{course.title} <em>{course.titleAccent}</em></h1>
  <p class="hc-hero__tagline">{course.tagline}</p>
  <p class="hc-hero__desc">{course.description}</p>
  <div class="hc-hero__meta">
    <span class="hc-hero__rating" aria-label={`Rated ${course.rating} out of 5`}>
      {course.rating}
      <span class="hc-stars">{Array.from({ length: 5 }, () => <Icon name="star" size={20} />)}</span>
    </span>
    <span><Icon name="user" size={20} />{course.learners}</span>
    <span><Icon name="clock" size={20} />{course.duration}</span>
  </div>
</header>
