---
// <mount path>/ → list of all courses (from Edmingle when configured).
import Layout from '../layouts/Layout.astro';
import ExploreCourses from '../components/course/ExploreCourses.astro';
import { getCourseCards } from '../lib/catalog';
import '../styles/course.css';

export const prerender = true;

const cards = await getCourseCards();
---
<Layout title="Courses | Happ Coach Academy">
  <div class="hc-page">
    <ExploreCourses
      cards={cards}
      title="Happ Coach Academy courses"
      subtitle="Pick a course to see its curriculum, reviews and price."
    />
  </div>
</Layout>
