---
// Course detail page → <mount path>/courses/<slug>
// Data comes from src/lib/catalog.ts: the Edmingle API when configured,
// otherwise the local files in src/data/.
import Layout from '../../layouts/Layout.astro';
import CourseHero from '../../components/course/CourseHero.astro';
import EnrollCard from '../../components/course/EnrollCard.astro';
import CourseTabs from '../../components/course/CourseTabs.astro';
import Overview from '../../components/course/Overview.astro';
import Curriculum from '../../components/course/Curriculum.astro';
import Testimonials from '../../components/course/Testimonials.astro';
import ExploreCourses from '../../components/course/ExploreCourses.astro';
import Faqs from '../../components/course/Faqs.astro';
import EdmingleSdk from '../../components/course/EdmingleSdk.astro';
import { getCoursePage, getCourseSlugs } from '../../lib/catalog';
import '../../styles/course.css';

// Built at deploy time: every course becomes a fast static page.
// To refresh prices/curriculum after changing them in Edmingle, redeploy
// (Webflow Cloud → Deploy latest commit, or the GitHub "Refresh courses" action).
export const prerender = true;

export async function getStaticPaths() {
  const slugs = await getCourseSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const page = await getCoursePage(Astro.params.slug!);
if (!page) throw new Error(`Course not found: ${Astro.params.slug}`);
const { course, related } = page;
const pageTitle = [course.title, course.titleAccent].filter(Boolean).join(' ');
---
<Layout title={`${pageTitle} | Happ Coach Academy`} description={course.tagline}>
  <div class="hc-page">
    <div class="hc-top hc-container">
      <div class="hc-grid">
        <div class="hc-grid__hero"><CourseHero course={course} /></div>
        <div class="hc-grid__card"><EnrollCard course={course} /></div>
        <div class="hc-grid__body">
          <CourseTabs />
          <Overview course={course} />
          <Curriculum course={course} />
        </div>
      </div>
    </div>
    {course.testimonials.length > 0 && <Testimonials items={course.testimonials} />}
    {related.length > 0 && <ExploreCourses cards={related} />}
    <Faqs intro={course.faqIntro} items={course.faqs} contactHref={course.contactHref} />
  </div>
  <EdmingleSdk />
</Layout>
