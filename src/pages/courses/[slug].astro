---
// Course detail page → /academy/courses/<slug>
import Layout from '../../layouts/Layout.astro';
import CourseHero from '../../components/course/CourseHero.astro';
import EnrollCard from '../../components/course/EnrollCard.astro';
import CourseTabs from '../../components/course/CourseTabs.astro';
import Overview from '../../components/course/Overview.astro';
import Curriculum from '../../components/course/Curriculum.astro';
import Testimonials from '../../components/course/Testimonials.astro';
import ExploreCourses from '../../components/course/ExploreCourses.astro';
import Faqs from '../../components/course/Faqs.astro';
import { courses, courseCards, getCourse } from '../../data/courses';
import '../../styles/course.css';

// Pre-render every course at build time (fast, works on Webflow Cloud).
export const prerender = true;
export function getStaticPaths() {
  return courses.map((c) => ({ params: { slug: c.slug } }));
}

const course = getCourse(Astro.params.slug!)!;
const related = course.related
  .map((slug) => courseCards.find((c) => c.slug === slug))
  .filter((c) => !!c);
---
<Layout title={`${course.title} ${course.titleAccent} | Happ Coach Academy`}>
  <div class="hc-page">
    <div class="hc-top hc-container">
      <div class="hc-grid">
        <div class="hc-grid__hero"><CourseHero course={course} /></div>
        <div class="hc-grid__card"><EnrollCard course={course} /></div>
        <div class="hc-grid__body">
          <CourseTabs />
          <Overview course={course} />
          <Curriculum course={course} />
        </div>
      </div>
    </div>
    <Testimonials items={course.testimonials} />
    <ExploreCourses cards={related} />
    <Faqs intro={course.faqIntro} items={course.faqs} contactHref={course.contactHref} />
  </div>
</Layout>
